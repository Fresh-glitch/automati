# Copy to .env (git-ignored) and fill in. Never commit the real file.

# CurseForge API token, generated under "API Tokens" in the author account:
# https://support.curseforge.com/support/solutions/articles/9000197321
CURSEFORGE_TOKEN=

# Modrinth personal access token with the "Create versions" scope. Add
# "Read user data" so that publish_modrinth.ps1 -DryRun can verify it.
MODRINTH_TOKEN=
